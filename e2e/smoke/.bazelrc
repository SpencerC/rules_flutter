# rules_android tracks ANDROID_HOME itself for the manual mobile targets.
# Do not forward it with --repo_env: Bazel 9.0.0 crashes if it is unset.

# iOS builds keep the host HOME so CocoaPods caches persist across builds.
build --action_env=HOME

# Bazel 9's protobuf dependency supplies matching prebuilt protoc toolchains.
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
