"""Repository rule that downloads a pub package's build-hook assets.

Each supported package has an adapter that knows where the package lists the
files its hook downloads, and which user_defines make the hook read them from
a local directory. The rule reads that list from the package's own pub
repository, so the downloads always match the package version in use and
carry the package's own sha256 pins. Bazel performs the downloads once, with
its repository cache, retries and `--downloader_config` mirrors, instead of
the hook downloading them in every build action.
"""

def parse_sqlite3_asset_hashes(content):
    """Parse package:sqlite3's lib/src/hook/asset_hashes.dart.

    The file is generated by the package (tool/write_asset_hashes.dart) and has
    the same shape in every release that has a build hook:

        const String? releaseTag = 'sqlite3-3.3.3';
        const Map<String, String> assetNameToSha256Hash = {
          'libsqlite3.x64.linux.so': '<sha256>',
          ...
        };

    Args:
      content: Text of asset_hashes.dart.

    Returns:
      A struct with `release_tag` (string, or None when the file is the
      development placeholder) and `sha256s` (dict of file name to sha256).
    """
    release_tag = None
    sha256s = {}
    in_map = False
    for raw in content.splitlines():
        line = raw.strip()
        if line.startswith("const String? releaseTag") or line.startswith("const String releaseTag"):
            value = line.split("=", 1)[1].strip().rstrip(";").strip()
            if value != "null":
                release_tag = value.strip("'\"")
        elif line.startswith("const Map<String, String> assetNameToSha256Hash"):
            in_map = True
        elif in_map:
            if line.startswith("}"):
                in_map = False
                continue
            if not line.startswith("'"):
                continue
            parts = line.rstrip(",").split(":")
            if len(parts) != 2:
                fail("Unexpected asset_hashes.dart entry: " + raw)
            sha256s[parts[0].strip().strip("'\"")] = parts[1].strip().strip("'\"")
    return struct(release_tag = release_tag, sha256s = sha256s)

def _sqlite3_assets(content, variant):
    parsed = parse_sqlite3_asset_hashes(content)
    if not parsed.release_tag:
        fail("package:sqlite3's asset_hashes.dart names no releaseTag; this sqlite3 version has no prebuilt release to download")
    prefix = "lib{}.".format(variant)
    files = {name: sha for name, sha in parsed.sha256s.items() if name.startswith(prefix)}
    if not files:
        fail("package:sqlite3 {} lists no prebuilt '{}' libraries; known variants are sqlite3, sqlite3mc and sqlcipher".format(
            parsed.release_tag,
            variant,
        ))
    return struct(
        url = "https://github.com/simolus3/sqlite3.dart/releases/download/{}/".format(parsed.release_tag),
        sha256s = files,
        # `test-<variant>` is the hook's mode for reading the prebuilt
        # libraries from `directory` instead of downloading them. It applies
        # the same sha256 check to the local files.
        user_defines = {"source": "test-" + variant},
        directory_define = "directory",
    )

# Package name -> adapter. `hash_file` is the package-relative file listing the
# hook's downloads; `assets(content, variant)` returns what to download and the
# user_defines that select the local mode.
HOOK_ASSET_ADAPTERS = {
    "sqlite3": struct(
        hash_file = "lib/src/hook/asset_hashes.dart",
        default_variant = "sqlite3",
        assets = _sqlite3_assets,
    ),
}

def _pub_hook_assets_repository_impl(rctx):
    adapter = HOOK_ASSET_ADAPTERS[rctx.attr.package]
    variant = rctx.attr.variant or adapter.default_variant
    hash_file = rctx.path(rctx.attr.package_pubspec).dirname.get_child(adapter.hash_file)
    if not hash_file.exists:
        fail("{} does not exist; this version of package:{} has no build hook downloads to replace".format(
            hash_file,
            rctx.attr.package,
        ))
    assets = adapter.assets(rctx.read(hash_file), variant)

    for name in sorted(assets.sha256s.keys()):
        rctx.download(
            url = assets.url + name,
            output = "files/" + name,
            sha256 = assets.sha256s[name],
        )

    rctx.file("BUILD.bazel", """\
load("@rules_flutter//flutter:defs.bzl", "flutter_hook_assets")

flutter_hook_assets(
    name = {name},
    package = {package},
    srcs = glob(["files/*"]),
    user_defines = {user_defines},
    directory_define = {directory_define},
    visibility = ["//visibility:public"],
)
""".format(
        name = repr(rctx.original_name),
        package = repr(rctx.attr.package),
        user_defines = repr(assets.user_defines),
        directory_define = repr(assets.directory_define),
    ))

    # Everything above is determined by the package version's hash file, so
    # Bazel may cache the repository across workspaces.
    return rctx.repo_metadata(reproducible = True)

pub_hook_assets_repository = repository_rule(
    implementation = _pub_hook_assets_repository_impl,
    doc = "Downloads a pub package's build-hook assets and declares a flutter_hook_assets target for them.",
    attrs = {
        "package": attr.string(
            mandatory = True,
            values = sorted(HOOK_ASSET_ADAPTERS.keys()),
            doc = "Pub package whose hook downloads to replace.",
        ),
        "package_pubspec": attr.label(
            mandatory = True,
            doc = "pubspec.yaml of the package's pub repository; locates its hash file.",
        ),
        "variant": attr.string(
            doc = "Adapter-specific selection, e.g. sqlite3's library (sqlite3, sqlite3mc or sqlcipher).",
        ),
    },
)
